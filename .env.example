# Frontend (Render Static Site)
VITE_BACKEND_URL=http://127.0.0.1:5000
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Or use publishable key instead of anon key:
# VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Local development only: used by Vite proxy. Do not rely on these in production browser.
VITE_SMS_API_KEY=YOUR_FORTIUS_API_KEY
VITE_SMS_SENDER_ID=DVRKRT
VITE_SMS_TEMPLATE_ID=YOUR_DLT_TEMPLATE_ID
VITE_SMS_BASE_URL=https://smsfortius.org/V2/apikey.php

# Supabase Edge Function secrets (set in Supabase, not Render)
SMS_API_KEY=YOUR_FORTIUS_API_KEY
SMS_SENDER_ID=DVRKRT
SMS_TEMPLATE_ID=YOUR_DLT_TEMPLATE_ID
SMS_BASE_URL=https://smsfortius.org/V2/apikey.php
